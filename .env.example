# Sao chép file này thành .env rồi điền giá trị. File .env KHÔNG gửi cho ai, KHÔNG đưa lên GitHub.

# Token Meta (System User token, bắt đầu bằng EAA...) — xem README mục 2
META_ACCESS_TOKEN=
# App Secret của app Meta (Cài đặt ứng dụng > Thông tin cơ bản) — nên điền để tăng bảo mật
META_APP_SECRET=

# Khoá truy cập MCP — để trống, npm run secrets sẽ tự tạo
MCP_AUTH_KEY=

# Địa chỉ Worker — để trống, npm run deploy sẽ tự điền
WORKER_URL=

# --- Tuỳ chọn: Supabase cho báo cáo lịch sử + dashboard (README mục 7) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
